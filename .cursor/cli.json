{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(git)",
      "Shell(npm)",
      "Shell(npx)",
      "Shell(node)",
      "Shell(powershell)",
      "Shell(cmd)"
    ],
    "deny": [
      "Shell(rm)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/.env.test)",
      "Write(**/.envrc)",
      "Write(**/id_rsa)",
      "Write(**/id_ed25519)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/.git/**)"
    ]
  }
}
